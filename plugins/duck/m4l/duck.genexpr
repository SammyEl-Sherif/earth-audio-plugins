// DUCK for Max for Live: a GenExpr port of the shared curve gain shaper (shared/dsp CurveGainShaper, ShapeCurve,
// StandardPresets). Keep in step with those headers; the preset table is generated from StandardPresets.h.
//
// in1/in2: audio L/R. in3: plugphasor~ (0..1 per beat, sample-locked to Live).
// out1/out2: audio L/R. out3: cycle phase 0..1. out4: applied gain 0..1.
//
// Per sample: curve = lut(phase); target = 1 - drywet * (1 - curve); gain = one-pole(target, 0.7 ms); drywet is
// smoothed over 15 ms. The 1024-point lut is re-baked (one sample, bounded loops) whenever the shape changes.

Param drywet(100, min=0, max=100);
Param division(1, min=0, max=3);
Param preset(0, min=0, max=16);
// @insert curveparams
Param hostplaying(0, min=0, max=1);
Param hostbpm(0, min=0, max=1000);
Param hostbeats(0, min=-1000000, max=1000000000);

Data lut(1025);
Data pre(784);
Data cur(49);
History ready(0);
History key(-1);
History freephase(0);
History gain(1);
History mixs(1);

if (ready < 0.5) {
	// @insert presets
	ready = 1;
}

// ---------- shape: preset 0..15, or 16 = the drawn curve (c0 = node count, then x y bend per node)
sr = samplerate;  // GenExpr has no built-in `sr`

pidx = clamp(floor(preset), 0, 16);
hash = pidx * 7.13;
// @insert curvehash
if (hash != key) {
	key = hash;
	if (pidx > 15.5) {
		// @insert copycustom
	} else {
		for (k = 0; k < 49; k += 1) {
			pv = peek(pre, (pidx * 49) + k, 0);
			poke(cur, pv, k, 0);
		}
	}
	n = clamp(floor(peek(cur, 0, 0)), 0, 16);
	if (n < 2) {
		poke(cur, 2, 0, 0);
		poke(cur, 0, 1, 0);
		poke(cur, 0, 2, 0);
		poke(cur, 0, 3, 0);
		poke(cur, 1, 4, 0);
		poke(cur, 1, 5, 0);
		poke(cur, 0, 6, 0);
		n = 2;
	}
	for (s = 0; s < (n - 1); s += 1) {
		ax = peek(cur, 1 + (s * 3), 0);
		ay = peek(cur, 2 + (s * 3), 0);
		ab = peek(cur, 3 + (s * 3), 0);
		bx = peek(cur, 4 + (s * 3), 0);
		by = peek(cur, 5 + (s * 3), 0);
		i0 = s < 0.5 ? 0 : ceil(ax * 1024);
		i1 = s > (n - 2.5) ? 1024 : (ceil(bx * 1024) - 1);
		span = bx - ax;
		pw = exp2(abs(ab) * 3);
		for (i = i0; i <= i1; i += 1) {
			tt = span > 0 ? clamp(((i / 1024) - ax) / span, 0, 1) : 1;
			sh = ab > 0 ? pow(tt, pw) : (1 - pow(1 - tt, pw));
			yv = ay + ((by - ay) * sh);
			poke(lut, yv, i, 0);
		}
	}
}

// ---------- phase: host-locked while Live plays, free-running at Live's tempo when stopped
beats = division < 0.5 ? 0.5 : (division < 1.5 ? 1 : (division < 2.5 ? 2 : 4));
spb = hostbpm > 1 ? ((60 * sr) / hostbpm) : (sr * 0.5);
playing = hostplaying > 0.5;
beatphase = clamp(in3, 0, 0.999999);
ppq = round(hostbeats - beatphase) + beatphase;
hph = ppq / beats;
hph = hph - floor(hph);
fph = freephase + (1 / (spb * beats));
fph = fph - floor(fph);
phase = playing ? hph : fph;
freephase = phase;

// ---------- gain
scaled = phase * 1024;
li = min(floor(scaled), 1023);
lf = scaled - li;
y0 = peek(lut, li, 0);
y1 = peek(lut, li + 1, 0);
curve = y0 + ((y1 - y0) * lf);

mixc = exp(-1 / (0.015 * sr));
gainc = exp(-1 / (0.0007 * sr));
mixs = (drywet * 0.01) + (mixc * (mixs - (drywet * 0.01)));
target = 1 - (mixs * (1 - curve));
gain = target + (gainc * (gain - target));

out1 = in1 * gain;
out2 = in2 * gain;
out3 = phase;
out4 = gain;
